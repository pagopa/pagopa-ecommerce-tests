    {
      "name": "Get last payment method used",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"[ecommerce for IO - Wallet Payment] - GET last payment method used\", () => {",
              "  pm.response.to.have.status(200);",
              "  const responseJson = pm.response.json();",
              "  pm.expect(responseJson.type).to.equals(\"wallet\");",
              "  pm.expect(responseJson.walletId).to.equals(pm.environment.get(\"WALLET_ID\"));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "async function waitForLastPaymentMethodUsed() {",
              "  const maxAttempts = 5;",
              "  let counter = 0;",
              "  let lastType = null;",
              "  const request = {",
              "    url: `${pm.environment.get('HOSTNAME')}/ecommerce/io/v2/user/lastPaymentMethodUsed`,",
              "    method: 'GET',",
              "    header: {",
              "      'Authorization': `Bearer ${pm.environment.get('SESSION_TOKEN')}`",
              "    }",
              "  };",
              "  while (counter < maxAttempts) {",
              "    await new Promise(r => setTimeout(r, 1000));",
              "    const response = await new Promise((resolve, reject) => pm.sendRequest(request, (error, response) => {",
              "      if (error) reject(error);",
              "      else resolve(response);",
              "    }));",
              "    lastType = response.json().type;",
              "    console.log(`Polling lastPaymentMethodUsed attempt ${counter + 1}: type=${lastType}`);",
              "    if (lastType === 'wallet') break;",
              "    counter++;",
              "  }",
              "}",
              "waitForLastPaymentMethodUsed();"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
